{
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.scrollback": 2000,
    // 打开代码自动提示
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    // 文件格式
    "emmet.syntaxProfiles": {
        "vue-html": "html",
        "vue": "html"
    },
    // tab 自动补全标签
    "emmet.triggerExpansionOnTab": true,
    // 代码缩进修改成4个空格 如果同时设置了eslint缩进会和其冲突(如果你不要eslint 可以放开下面三个配置)
    // "editor.tabSize": 4,
    // "editor.formatOnType": true, // 代码格式化 同eslint冲突
    "editor.formatOnSave": true, // 代码保存时自动格式化 同eslint冲突
    // 不檢查縮進，保存后統一按設置項來設置
    "editor.detectIndentation": false,
    // 控制 Markdown 预览中使用的字号(以像素为单位)。
    "markdown.preview.fontSize": 13,
    // 控制终端的字号(以像素为单位)。
    "terminal.integrated.fontSize": 12,
    // 切换文件时自动保存
    "files.autoSave": "off",
    // 减少本地测试时的文件监听与搜索负担
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/.cache/**": true,
        "**/.turbo/**": true,
        "**/coverage/**": true,
        "**/playwright-report/**": true,
        "**/test-results/**": true,
        "00docs/**": false,
        "01工具合集/**": true,
        "avue-data/dist/**": true,
        "avue-data/node_modules/**": true,
        "avue-data/.cache/**": true,
        "aspnet-core/.vs/**": true,
        "aspnet-core/.yoyoboot-cli/**": true,
        "aspnet-core/artifacts/**": true,
        "aspnet-core/**/bin/**": true,
        "aspnet-core/**/obj/**": true,
        "aspnet-core/**/TestResults/**": true,
        "ele-login-rsa/node_modules/**": true,
        "ele-login-rsa/dist/**": true,
        "uni-app/dist/**": true,
        "uni-app/.vite/**": true,
        "uni-app/node_modules/**": true,
        "uni-app/unpackage/**": true,
        "vue/dist/**": true,
        "vue/.vite/**": true,
        "vue/node_modules/**": true,
        "vue/playwright-report/**": true,
        "vue/test-results/**": true
    },
    "search.exclude": {
        "**/.git/**": true,
        "**/.cache/**": true,
        "**/.turbo/**": true,
        "**/coverage/**": true,
        "**/playwright-report/**": true,
        "**/test-results/**": true,
        "00docs/**": false,
        "01工具合集/**": true,
        "avue-data/dist/**": true,
        "avue-data/node_modules/**": true,
        "avue-data/.cache/**": true,
        "aspnet-core/.vs/**": true,
        "aspnet-core/.yoyoboot-cli/**": true,
        "aspnet-core/artifacts/**": true,
        "aspnet-core/**/bin/**": true,
        "aspnet-core/**/obj/**": true,
        "ele-login-rsa/node_modules/**": true,
        "ele-login-rsa/dist/**": true,
        "uni-app/dist/**": true,
        "uni-app/.vite/**": true,
        "uni-app/node_modules/**": true,
        "uni-app/unpackage/**": true,
        "vue/dist/**": true,
        "vue/.vite/**": true,
        "vue/node_modules/**": true,
        "vue/playwright-report/**": true,
        "vue/test-results/**": true
    },
    // 文件保存时自动去除多余的空格
    "files.trimTrailingWhitespace": true,
    // 终端选中即复制
    "terminal.integrated.copyOnSelection": true,
    // "eslint.autoFixOnSave": true,
    // "eslint.validate": [
    //     "javascript",
    //     "javascriptreact",
    //     "html",
    //     {
    //         "language": "vue",
    //         "autoFix": true
    //     }
    // ],
    "eslint.options": {
        "plugins": [
            "html"
        ]
    },
    //空格
    "javascript.format.insertSpaceBeforeFunctionParenthesis": true,
    "i18n-ally.localesPaths": [
        "src/shared/i18n",
        "public/resource/tinymce/langs",
        "src/app/admin/languages"
    ],
    "ipynb.pasteImagesAsAttachments.enabled": false,
    "markdown-preview-enhanced.plantumlServer": "https://kroki.io/plantuml/svg/",
    "prettier.configPath": ".prettierrc",
    "prettier.requireConfig": true,
    "prettier.useEditorConfig": false,
    // 換行
    "editor.wordWrap": "on",
    // MCP (Model Context Protocol) 配置
    // GitLens 自定义远程仓库
    "gitlens.remotes": [
        {
            // 远程仓库在本地 git 中的名称（默认叫 origin，可按需改）
            "name": "origin",
            // 域名（支持端口，如 git.dev.52abp.com:3000）
            "domain": "git.dev.52abp.com",
            // 指定这是一台 Gitea 服务器
            "type": "Gitea",
            // 如果你的 Gitea 装在子路径下，把 / 换成 /gitea 之类的即可
            "protocols": [
                "https"
            ],
            // 选填：如果 Gitea 强制走 HTTPS，可写死
            // "urls": {
            //   "repository": "https://git.dev.52abp.com/{owner}/{repo}",
            //   "branches":   "https://git.dev.52abp.com/{owner}/{repo}/branches",
            //   "branch":     "https://git.dev.52abp.com/{owner}/{repo}/src/branch/{branch}",
            //   "commit":     "https://git.dev.52abp.com/{owner}/{repo}/commit/{id}",
            //   "file":       "https://git.dev.52abp.com/{owner}/{repo}/src/commit/{id}/{file}",
            //   "fileInBranch": "https://git.dev.52abp.com/{owner}/{repo}/src/branch/{branch}/{file}",
            //   "fileLine":   "https://git.dev.52abp.com/{owner}/{repo}/src/commit/{id}/{file}#L{line}",
            //   "fileRange":  "https://git.dev.52abp.com/{owner}/{repo}/src/commit/{id}/{file}#L{start}-L{end}"
            // }
        }
    ],
    "gitlens.codeLens.enabled": false,
    "gitlens.currentLine.enabled": false,
    "gitlens.currentLine.pullRequests.enabled": false,
    "gitlens.statusBar.enabled": false,
    "gitlens.statusBar.pullRequests.enabled": false,
    "gitlens.hovers.enabled": false,
    "gitlens.hovers.pullRequests.enabled": false,
    "gitlens.terminalLinks.enabled": false,
    "gitlens.integrations.enabled": false,
    "gitlens.ai.enabled": false,
    "gitlens.cloudPatches.enabled": false,
    "gitlens.experimental.cloudIntegrations.enabled": false,
    "gitlens.graph.pullRequests": false,
    "gitlens.launchpad.indicator.enabled": false,
    "gitlens.launchpad.indicator.polling.enabled": false,
    "gitlens.views.launchpad.enabled": false,
    "gitlens.views.repositories.autoRefresh": false,
    "gitlens.views.repositories.autoReveal": false,
    "gitlens.views.repositories.includeWorkingTree": false,
    "gitlens.views.repositories.showBranches": false,
    "gitlens.views.repositories.showCommits": false,
    "gitlens.views.repositories.showContributors": false,
    "gitlens.views.repositories.showIncomingActivity": false,
    "gitlens.views.repositories.showRemotes": false,
    "gitlens.views.repositories.showStashes": false,
    "gitlens.views.repositories.showTags": false,
    "gitlens.views.repositories.showUpstreamStatus": false,
    "chat.agent.maxRequests": 200,
    "dotnetAcquisitionExtension.sharedExistingDotnetPath": "C:\\Program Files\\dotnet\\dotnet.exe",
    "dotnet.codeLens.enableReferencesCodeLens": false,
    "dotnet.codeLens.enableTestsCodeLens": false,
    "dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "openFiles",
    "dotnet.backgroundAnalysis.compilerDiagnosticsScope": "openFiles",
    "dotnet.preferVisualStudioCodeFileSystemWatcher": true,
    "dotnet.automaticallyCreateSolutionInWorkspace": false,
    "dotnet.testWindow.disableAutoDiscovery": true,
    "dotnet.testWindow.disableBuildOnRefresh": true,
    "csharp.debug.hotReloadOnSave": false,
    "chat.mcp.serverSampling": {
        "src/.vscode/mcp.json: sequential-thinking": {
            "allowedModels": [
                "copilot/claude-3.7-sonnet-thought",
                "copilot/claude-sonnet-4",
                "copilot/gpt-5"
            ]
        },
        "src/.vscode/mcp.json: context7": {
            "allowedModels": [
