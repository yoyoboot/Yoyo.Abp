<Project>
    <PropertyGroup>
        <Version>10.3.0</Version>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PackageIcon>logo_600.png</PackageIcon>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/yoyoboot/Yoyo.Abp</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/yoyoboot/Yoyo.Abp</RepositoryUrl>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release' ">
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../../LICENSE.md" Pack="true" PackagePath="/"/>
        <None Include="../../nupkg/logo_600.png" Pack="true" PackagePath="/"/>
    </ItemGroup>
	<ItemGroup>
      <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" >
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      </PackageReference>
    </ItemGroup>
</Project>
